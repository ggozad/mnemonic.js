{
  "name": "@ggozad/mnemonic",
  "version": "2.0.0",
  "description": "Memorable random phrases of known strength",
  "license": "MIT",
  "author": "Yiorgis Gozadinos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ggozad/mnemonic.js.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=23.6"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/*.test.ts'",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
